# Supabase — .env.local oluşturmak için kopyalayın; değerleri doldurun.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
#
# Giriş (Auth) için: geçerli URL + anon anahtarı tanımlıysa Uygulama ÖNCELİKLİ olarak
# Supabase Auth kullanır. Firebase yapılandırması yalnızca Firestore/canlı görev verisi için
# opsiyonel kalabilir.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-key-min-20-characters

# Supabase profil tablosunu bir kez çalıştırın:
# scripts/supabase-auth-profiles.sql → SQL Editor

# Firebase (isteğe bağlı) — Yalnızca Firestore (canlı tablo görevleri) için.
# NEXT_PUBLIC_FIREBASE_* yoksa veya eksikse; Supabase ile giriş + demo verisi kullanılırken
# Firebase tarafı kapanır.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tam yönetici e-postaları: varsayılan ugurgrses@gmail.com ile birlikte virgülle ek liste
# NEXT_PUBLIC_ADMIN_EMAILS=arkadas@firma.com
