# Kopyalayın → .env.local ve değerleri doldurun.
# Dashboard: Supabase Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-minimum-20-chars-not-placeholder

# Supabase olmadan yerel demo (varsayılan: kapalı — üretimde tanımlamayın):
# NEXT_PUBLIC_ALLOW_DEMO_MODE=true

# Profil rolleri (giriş sonrası) — bir kez SQL Editor’da çalıştırın:
# scripts/supabase-auth-profiles.sql

# Tam yönetici e-postaları (isteğe bağlı, kodda sabit adresle birlikte):
# NEXT_PUBLIC_ADMIN_EMAILS=ornekbir@gmail.com,diger@sirket.com

# ─────────────────────────────────────────────────────────────────────
# E-POSTA BİLDİRİMLERİ (Phase 2)
# resend.com'a kayıt ol → API key al. Ücretsiz tier: 3000 mail/ay.
# ─────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
#
# Production'da kendi domain'inden gönderim için Resend'de doğrulanmış adres:
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# (Boş bırakırsan onboarding@resend.dev kullanılır — sadece test için)
#
# E-posta linklerinde kullanılan public URL:
# NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
#
# SANDBOX TEST modu — Resend'de domain doğrulamadıysan:
# Resend "onboarding@resend.dev" from adresi sadece hesap sahibi e-postasına
# gönderir; diğer adresler 403 ile reddedilir. Aşağıdaki değişken tanımlıysa,
# kod sadece bu adrese mail atar (test için), production'da kaldır.
# RESEND_TEST_RECIPIENT=senin@email.com
