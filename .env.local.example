# Supabase - .env.local dosyasını bu örnekten oluşturup değerleri doldurun.
# Supabase Dashboard > Project Settings > API

# --- Railway ---
# Proje → Variables: aynı isimlerle ekleyin. NEXT_PUBLIC_* değerleri `npm run build`
# sırasında istemci paketine gömülür; ilk deploy önce değişkenleri kaydedin.
# Bu repoda railway.json Railpack kullanır (Dockerfile yerine). Docker ile
# build istiyorsanız Railway servisinde builder'ı Dockerfile yapıp build-arg tanımlayın.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Firebase (opsiyonel) - Tanımlıysa giriş Firebase Auth ile yapılır; yoksa mock kullanıcı kullanılır.
# Firebase Console > Project Settings > General > Your apps

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
